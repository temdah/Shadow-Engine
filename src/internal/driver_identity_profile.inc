typedef struct DriverProofSpan {
    uint64_t rva;
    const unsigned char *bytes;
    size_t size;
} DriverProofSpan;

typedef struct DriverIdentityProfile {
    uint64_t pawn_class_id_rva;
    uint64_t vehicle_class_id_rva;
    const DriverProofSpan *spans;
    size_t span_count;
    uint32_t pawn_class_id;
    uint32_t vehicle_class_id;
} DriverIdentityProfile;

