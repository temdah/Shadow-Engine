/* Optional Global population observation proof and pure copied-input evaluator.
 * Native offsets are immutable profile data, never inferred from relocation.
 * Failed proof disables diagnostics only. No native function here is invoked. */
#ifndef SHADOW_ENGINE_POPULATION_CAPTURE_PROFILE_INC
#define SHADOW_ENGINE_POPULATION_CAPTURE_PROFILE_INC

typedef struct PopulationProofSpan {
    uint64_t rva;
    const unsigned char *bytes;
    size_t size;
} PopulationProofSpan;

typedef struct PopulationCaptureLayout {
    uint32_t candidate_next,candidate_descriptor,candidate_spatial;
    uint32_t candidate_factor,candidate_coverage,candidate_backing;
    uint32_t descriptor_type,descriptor_enable,descriptor_factor,descriptor_flags;
    uint32_t spatial_descriptor_handle;
    uint32_t manager_config,manager_owner_vector,manager_owner_count;
    uint32_t manager_owner_encoded_capacity,manager_cache_limit;
    uint32_t manager_cache_dimension,manager_new_owner_update,manager_scheduler;
    uint32_t config_type3_enable,config_coverage_threshold,config_reduced;
    uint32_t context_table_slot_bias,context_table_slot_stride;
    uint32_t context_width,context_height;
    uint32_t binding_header_data,binding_header_count,binding_stride;
    uint32_t binding_candidate,binding_owner,binding_update;
    uint32_t owner_stride,owner_identity,owner_age,owner_initialized,owner_backing;
} PopulationCaptureLayout;

typedef struct PopulationCaptureProfile {
    const PopulationProofSpan *spans;
    size_t span_count;
    PopulationCaptureLayout layout;
    uint32_t context_index_rva,epsilon_rva,coverage_numerator_rva;
    uint32_t epsilon_bits,coverage_numerator_bits;
} PopulationCaptureProfile;

