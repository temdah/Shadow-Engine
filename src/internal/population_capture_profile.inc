#define PG_VALID_DESCRIPTOR 1U
#define PG_VALID_CANDIDATE 2U
#define PG_VALID_CONFIG 4U
#define PG_VALID_CONTEXT 8U
#define PG_VALID_CONSTANTS 16U
#define PG_VALID_MXCSR 32U

/* PG_VALID_CONSTANTS certifies copied constant bits match the armed profile's
 * exact expected values; readable but changed constants are not valid. */
typedef struct PopulationGateInputs {
    uint32_t valid,raw_type,enabled;
    uint32_t descriptor_factor_bits,candidate_factor_bits,descriptor_flags;
    uint32_t type3_enabled,threshold_bits,reduced,coverage,width,height;
    uint32_t epsilon_bits,numerator_bits,mxcsr;
} PopulationGateInputs;

typedef enum PopulationGateResult {
    PG_UNKNOWN=0,
    PG_DISABLED,
    PG_DESCRIPTOR_FACTOR,
    PG_CANDIDATE_FACTOR,
    PG_TYPE2_FLAGS,
    PG_TYPE4,
    PG_TYPE3_CONFIG,
    PG_COVERAGE,
    PG_SPECIAL_ELIGIBLE,
    PG_ORDINARY_ELIGIBLE
} PopulationGateResult;

static uint32_t population_capture_mxcsr(void)
{
    uint32_t value=0;
    /* TinyCC 0.9.27 does not recognize the mnemonic. 0F AE /3 with ModRM18
     * is STMXCSR [RAX]; the input binds only our four-byte stack destination. */
    __asm__ __volatile__(".byte 0x0f,0xae,0x18" : : "a"(&value) : "memory");
    return value;
}

/* Inspect bits before floating operations: COMISS unordered branches differ
 * from ordinary C comparisons, and signaling NaNs must not raise here.
 * Subnormal inputs remain unknown because DAZ/FTZ can change native behavior. */
static int population_gate_normal_or_zero(uint32_t bits)
{
    uint32_t magnitude=bits&0x7FFFFFFFU;
    return magnitude<0x7F800000U &&
        (magnitude==0U || magnitude>=0x00800000U);
}

static float population_gate_float(uint32_t bits)
{
    union { uint32_t bits; float value; } copy;
    copy.bits=bits;
    return copy.value;
}

/* The result reconstructs copied PRE-BUDGET inputs. It is never an actual
 * branch trace or a substitute for complete native binding observation. */
static PopulationGateResult population_gate_evaluate(const PopulationGateInputs *in)
{
    float epsilon,descriptor_factor,candidate_factor,threshold;
    uint32_t product,denominator;
    volatile float denominator_float,scale,coverage_float,scaled;
    if(!in || !(in->valid&PG_VALID_DESCRIPTOR)) return PG_UNKNOWN;
    if(!in->enabled) return PG_DISABLED;
    if(!(in->valid&PG_VALID_CONSTANTS) ||
       !population_gate_normal_or_zero(in->epsilon_bits) ||
       !population_gate_normal_or_zero(in->descriptor_factor_bits))
        return PG_UNKNOWN;
    epsilon=population_gate_float(in->epsilon_bits);
    descriptor_factor=population_gate_float(in->descriptor_factor_bits);
    if(epsilon>descriptor_factor) return PG_DESCRIPTOR_FACTOR;
    if(!(in->valid&PG_VALID_CANDIDATE) ||
       !population_gate_normal_or_zero(in->candidate_factor_bits))
        return PG_UNKNOWN;
    candidate_factor=population_gate_float(in->candidate_factor_bits);
    if(epsilon>candidate_factor) return PG_CANDIDATE_FACTOR;
    if(in->raw_type==0U) return PG_SPECIAL_ELIGIBLE;
    if(in->raw_type==2U)
        return (in->descriptor_flags&0x84000000U) ?
            PG_SPECIAL_ELIGIBLE:PG_TYPE2_FLAGS;
    if(in->raw_type==4U) return PG_TYPE4;
    if(!(in->valid&PG_VALID_CONFIG)) return PG_UNKNOWN;
    if(in->raw_type==3U && !in->type3_enabled) return PG_TYPE3_CONFIG;
    if(!population_gate_normal_or_zero(in->threshold_bits)) return PG_UNKNOWN;
    threshold=population_gate_float(in->threshold_bits);
    if(threshold<=0.0f || in->reduced) return PG_ORDINARY_ELIGIBLE;
    if((in->valid&(PG_VALID_CONTEXT|PG_VALID_MXCSR))!=
       (PG_VALID_CONTEXT|PG_VALID_MXCSR) ||
       (in->mxcsr&0x6000U)!=0U ||
       !population_gate_normal_or_zero(in->numerator_bits) ||
       population_gate_float(in->numerator_bits)<=0.0f)
        return PG_UNKNOWN;
    /* Native IMUL keeps low32, then signed CMOVG selects max(product,1).
     * Do not widen the area multiplication or invoke signed-overflow UB. */
    product=in->width*in->height;
    denominator=(product&0x80000000U) || product<=1U ? 1U:product;
    denominator_float=(float)(int32_t)denominator;
    scale=population_gate_float(in->numerator_bits)/denominator_float;
    coverage_float=(float)(int64_t)(uint64_t)in->coverage;
    scaled=coverage_float*scale;
    /* Binary32 stores preserve the native sequence of rounded operations.
     * The proved numerator1 and integer ranges cannot overflow/underflow. */
    if(scaled<threshold) return PG_COVERAGE;
    return PG_ORDINARY_ELIGIBLE;
}

static const char *population_gate_name(PopulationGateResult result)
{
    switch(result) {
    case PG_DISABLED: return "disabled";
    case PG_DESCRIPTOR_FACTOR: return "descriptorFactorBelowEpsilon";
    case PG_CANDIDATE_FACTOR: return "candidateFactorBelowEpsilon";
    case PG_TYPE2_FLAGS: return "type2FlagsRejected";
    case PG_TYPE4: return "type4Excluded";
    case PG_TYPE3_CONFIG: return "type3ConfigDisabled";
    case PG_COVERAGE: return "coverageBelowThreshold";
    case PG_SPECIAL_ELIGIBLE: return "specialEligible";
    case PG_ORDINARY_ELIGIBLE: return "ordinaryEligible";
    default: return "unknown";
    }
}

#define POPULATION_GLOBAL_PROFILE (&g_global_population_capture_profile)
#else
#define POPULATION_GLOBAL_PROFILE NULL
#endif

